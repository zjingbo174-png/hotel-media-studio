{
  "name": "hotel-media-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "酒店自媒体创作工作台：每日计划打卡 / 选题灵感 / 爆款热点二创，手机端优先的 PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:data": "vitest run src/data/data.test.ts",
    "api:dev": "node server/dev.mjs",
    "api:test": "node scripts/api-test.mjs",
    "check:online": "node scripts/e2e-online.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.0"
  }
